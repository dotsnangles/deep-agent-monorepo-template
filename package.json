{
  "name": "hollow-echo-distant-signal",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "nx run-many -t dev --output-style=stream",
    "build": "nx run-many -t build",
    "check-types": "nx run-many -t check-types",
    "test": "vitest run",
    "dev:web": "nx run-many -t dev --projects=web",
    "dev:server": "nx run-many -t dev --projects=server",
    "dev:agent": "nx run-many -t dev --projects=agent",
    "db:push": "nx run-many -t db:push --projects=@repo/db",
    "db:studio": "nx run-many -t db:studio --projects=@repo/db",
    "db:generate": "nx run-many -t db:generate --projects=@repo/db",
    "db:migrate": "nx run-many -t db:migrate --projects=@repo/db",
    "db:start": "docker compose up -d postgres",
    "db:watch": "docker compose up postgres",
    "db:stop": "docker compose stop postgres",
    "db:down": "docker compose down postgres",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "dependencies": {
    "@repo/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@types/node": "^22.20.1",
    "nx": "^23.1.0",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.9.0"
}
